{
  "name": "polka",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start:frontend": "npm --workspace frontend run start --",
    "build:frontend": "npm --workspace frontend run build",
    "test:frontend": "npm --workspace frontend run test",
    "test:component": "playwright test",
    "test:component:headed": "playwright test --headed",
    "playwright:install": "playwright install chromium",
    "deploy:polka:k8s": "./scripts/deploy/polka-bootstrap-k8s.sh",
    "lint:frontend": "npm --workspace frontend run lint",
    "lint:styles": "npm --workspace frontend run lint:styles",
    "format:check": "npm --workspace frontend run format:check",
    "start:backend": "go -C backend run ./cmd/api",
    "build:backend": "go -C backend build ./cmd/api",
    "test:backend": "go -C backend test ./...",
    "lint": "npm run lint:frontend && npm run lint:styles",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:check": "docker compose config",
    "demo:seed": "node scripts/demo/seed.mjs",
    "demo:covers": "node scripts/demo/covers.mjs",
    "demo:capture": "node scripts/demo/capture.mjs",
    "audit:backend": "go -C backend run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./..."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "overrides": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "minimatch@>=10.0.0 <10.2.6": "10.2.6"
  }
}
